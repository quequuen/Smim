# 이 파일을 .env 로 복사한 뒤 값을 채운다.
#   cp .env.example .env
#
# EXPO_PUBLIC_API_URL 은 세 가지로 쓴다.
#
#   (비워 둠)   서버 없이 mock 으로 돈다 — 화면 · 오류 상태만 볼 때
#   auto        Metro 가 알려준 주소에서 맥의 IP 를 자동으로 꺼낸다 (개발 기본값)
#   http://...  그 주소를 그대로 쓴다 — 배포는 이것만 쓴다
#
# auto 를 쓰면 Wi-Fi 가 바뀌어 IP 가 달라져도 이 파일을 고칠 필요가 없다.
# 폰과 맥이 같은 Wi-Fi 에 있어야 하는 것은 그대로다.
#
# 직접 주소를 적을 때 localhost 를 쓰면 안 된다 — 폰 입장에서 localhost 는 폰 자신이다.
# 맥의 LAN IP 를 쓴다: ipconfig getifaddr en0
EXPO_PUBLIC_API_URL=auto

# auto 가 붙일 포트. 루트 .env 의 SERVER_PORT 와 맞춘다 (기본 8082)
# EXPO_PUBLIC_API_PORT=8082
