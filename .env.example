# 이 파일을 .env 로 복사한 뒤 값을 채운다.
#   cp .env.example .env
#
# .env 는 docker compose 와 Spring Boot 가 함께 읽는다.
# .env 는 절대 커밋하지 않는다 (.gitignore 에 등록됨).

# ── PostgreSQL ────────────────────────
# 호스트에서 쓸 포트. 다른 프로젝트와 겹치면 여기만 바꾼다
POSTGRES_PORT=5433
POSTGRES_DB=smim
POSTGRES_USER=smim
POSTGRES_PASSWORD=change-me

# ── Redis ─────────────────────────────
REDIS_PORT=6380
REDIS_PASSWORD=change-me

# ── 서버 ──────────────────────────────
# 8081 은 Expo Metro 번들러가 쓰므로 피한다
SERVER_PORT=8082
