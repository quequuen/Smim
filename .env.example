# 이 파일을 .env 로 복사한 뒤 값을 채운다.
#   cp .env.example .env
#
# .env 는 docker compose 와 Spring Boot 가 함께 읽는다.
# .env 는 절대 커밋하지 않는다 (.gitignore 에 등록됨).

# ── PostgreSQL ────────────────────────
POSTGRES_DB=smim
POSTGRES_USER=smim
POSTGRES_PASSWORD=change-me

# ── Redis ─────────────────────────────
REDIS_PASSWORD=change-me
